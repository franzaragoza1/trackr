{
  "name": "track-manager",
  "version": "0.1.0",
  "description": "Track Manager — a local, private task manager to move your music tracks from idea to released.",
  "main": "main.js",
  "author": "AKM",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.akm.trackr",
    "productName": "trackr",
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "free-config.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "mac": {
      "target": "dmg",
      "category": "public.app-category.music",
      "icon": "build/icon.png"
    },
    "dmg": {
      "title": "trackr"
    }
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  }
}

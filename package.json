{
  "name": "track-manager",
  "version": "0.1.0",
  "description": "Track Manager — a local, private task manager to move your music tracks from idea to released.",
  "main": "main.js",
  "author": "AKM",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "build": {
    "appId": "com.akm.trackmanager",
    "productName": "Track Manager",
    "files": [
      "main.js",
      "preload.js",
      "src/**/*"
    ],
    "win": {
      "target": "nsis"
    }
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  }
}
